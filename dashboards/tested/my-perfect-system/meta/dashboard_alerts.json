      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Rules by group",
          "description": "Rule count per rule group (alerting + recording), cluster-wide.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "spec": {
                        "exemplar": false,
                        "expr": "sort_desc(sum by (rule_group) (label_replace(max by (rule_group, type) (grafana_alerting_rule_group_rules{job=\"monitoring-grafana\"}), \"rule_group\", \"$1\", \"rule_group\", \".*;(.*)\")))",
                        "instant": true,
                        "legendFormat": "{{rule_group}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "13.0.2",
            "spec": {
              "options": {
                "displayMode": "lcd",
                "maxVizHeight": 300,
                "minVizHeight": 16,
                "minVizWidth": 8,
                "namePlacement": "left",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [],
                  "fields": "",
                  "values": true
                },
                "showUnfilled": true,
                "sizing": "auto",
