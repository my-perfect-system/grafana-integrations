{
  "folder": "alerts/my-perfect-system/meta",
  "orgId": 1,
  "interval": 60,
  "title": "grafana",
  "rules": [
    {
      "uid": "meta_grafana_down",
      "title": "meta_grafana_down",
      "condition": "C",
      "for": "5m",
      "noDataState": "NoData",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "service": "grafana",
        "view": "meta"
      },
      "annotations": {
        "summary": "Grafana self target is down",
        "description": "The Grafana target {{ $labels.instance }} has been unreachable for 5m. (Only fires if Grafana recovers/another instance evaluates it; cross-check manually.)"
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "up{job=\"monitoring-grafana\"}",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    1
                  ],
                  "type": "lt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    },
    {
      "uid": "meta_grafana_alerts_invalid",
      "title": "meta_grafana_alerts_invalid",
      "condition": "C",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "warning",
        "service": "grafana",
        "view": "meta"
      },
      "annotations": {
        "summary": "Grafana received invalid alerts",
        "description": "Grafana saw invalid alert payloads in the last 30m ({{ $value }})."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "sum(increase(grafana_alerting_alerts_invalid_total{job=\"monitoring-grafana\"}[30m])) > 0",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    },
    {
      "uid": "meta_grafana_notification_write_failures",
      "title": "meta_grafana_notification_write_failures",
      "condition": "C",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "warning",
        "service": "grafana",
        "view": "meta"
      },
      "annotations": {
        "summary": "Grafana notification history write failures",
        "description": "Grafana failed writing alert notification history in the last 30m ({{ $value }})."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "sum(increase(grafana_alerting_notification_history_writes_failed_total{job=\"monitoring-grafana\"}[30m])) > 0",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    }
  ]
}