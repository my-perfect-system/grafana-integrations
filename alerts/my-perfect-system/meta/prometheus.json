{
  "folder": "alerts/my-perfect-system/meta",
  "orgId": 1,
  "interval": 60,
  "title": "prometheus",
  "rules": [
    {
      "uid": "meta_prometheus_down",
      "title": "meta_prometheus_down",
      "condition": "C",
      "for": "5m",
      "noDataState": "NoData",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "service": "prometheus",
        "view": "meta"
      },
      "annotations": {
        "summary": "Prometheus self target is down",
        "description": "The Prometheus target {{ $labels.instance }} has been unreachable for 5m."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "up{job=\"prometheus\"}",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    1
                  ],
                  "type": "lt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    },
    {
      "uid": "meta_prometheus_tsdb_compactions_failed",
      "title": "meta_prometheus_tsdb_compactions_failed",
      "condition": "C",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "service": "prometheus",
        "view": "meta"
      },
      "annotations": {
        "summary": "Prometheus TSDB compaction failures",
        "description": "Prometheus reported TSDB compaction failures in the last 30m ({{ $value }})."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "increase(prometheus_tsdb_compactions_failed_total{job=\"prometheus\"}[30m]) > 0",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    },
    {
      "uid": "meta_prometheus_tsdb_wal_writes_failed",
      "title": "meta_prometheus_tsdb_wal_writes_failed",
      "condition": "C",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "service": "prometheus",
        "view": "meta"
      },
      "annotations": {
        "summary": "Prometheus TSDB WAL write failures",
        "description": "Prometheus failed WAL writes in the last 30m ({{ $value }}), usually a storage/disk problem."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "increase(prometheus_tsdb_wal_writes_failed_total{job=\"prometheus\"}[30m]) > 0",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    }
  ]
}