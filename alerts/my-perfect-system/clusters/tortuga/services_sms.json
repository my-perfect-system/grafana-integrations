    {
      "uid": "tortuga_services_sms_down",
      "title": "tortuga_services_sms_down",
      "condition": "C",
      "for": "5m",
      "noDataState": "NoData",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "service": "sms",
        "view": "service"
      },
      "annotations": {
        "summary": "SMS exporter is down on {{ $labels.mps_alloy_hostname }}",
        "description": "The SMS exporter scrape target on {{ $labels.mps_alloy_hostname }} ({{ $labels.instance }}) has been unreachable for 5m."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "up{job=\"sms\"}",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    1
                  ],
                  "type": "lt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
