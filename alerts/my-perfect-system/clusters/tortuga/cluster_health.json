{
  "folder": "alerts/my-perfect-system/clusters/tortuga",
  "orgId": 1,
  "title": "cluster_health",
  "interval": 60,
  "rules": [
    {
      "uid": "tortuga_cluster_health_hosts_up",
      "title": "tortuga_cluster_health_hosts_up",
      "condition": "C",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "category": "cluster",
        "view": "cluster",
        "cluster": "tortuga"
      },
      "annotations": {
        "summary": "Host {{ $labels.mps_alloy_hostname }} is not reporting",
        "description": "A host listed in mps_tortuga_host_expected has been down (up != 1) for 5m. Expected hosts are maintained in the mps_tortuga_host_expected recording rule (defined in the cluster_recordings group)."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "mps_tortuga_host_expected unless on(mps_alloy_hostname) (up{job=\"integrations/unix\"} == 1)",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    }
  ]
}
