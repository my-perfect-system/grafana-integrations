      "title": "tortuga_host_meta_memory_high",
      "condition": "C",
      "for": "15m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "warning",
        "service": "alloy",
        "view": "meta"
      },
      "annotations": {
        "summary": "Alloy memory high on {{ $labels.instance }}",
        "description": "Alloy on {{ $labels.instance }} is using more than 2 GiB resident memory for 15m \u2014 possible leak or backlog growth."
