      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "service": "alloy",
        "view": "meta"
      },
      "annotations": {
        "summary": "Alloy remote write WAL corruption on {{ $labels.instance }}",
        "description": "Alloy's remote-write WAL on {{ $labels.instance }} reported a corruption \u2014 queued samples may be lost on restart."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
