    {
      "uid": "tortuga_host_meta_restarted",
      "title": "tortuga_host_meta_restarted",
      "condition": "C",
      "for": "0m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "warning",
        "service": "alloy",
        "view": "meta"
      },
      "annotations": {
        "summary": "Alloy restarted on {{ $labels.instance }}",
        "description": "Alloy on {{ $labels.instance }} (re)started less than 10 minutes ago \u2014 watch for crash loops."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
