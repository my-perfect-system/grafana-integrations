{
  "folder": "alerts/my-perfect-system/clusters/tortuga",
  "orgId": 1,
  "title": "services_blackbox",
  "interval": 60,
  "rules": [
    {
      "uid": "tortuga_services_blackbox_target_down",
      "title": "tortuga_services_blackbox_target_down",
      "condition": "C",
      "for": "5m",
      "noDataState": "NoData",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "service": "blackbox",
        "view": "service"
      },
      "annotations": {
        "summary": "Blackbox probe {{ $labels.instance }} is down",
        "description": "The blackbox probe for {{ $labels.instance }} has been failing (probe_success == 0) for 5m."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "probe_success",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    1
                  ],
                  "type": "lt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    },
    {
