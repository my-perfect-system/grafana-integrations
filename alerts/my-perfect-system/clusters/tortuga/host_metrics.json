            "from": 3600,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "predict_linear(node_filesystem_avail_bytes{job=\"integrations/unix\",fstype!~\"tmpfs|overlay|squashfs|devtmpfs\"}[1h], 86400)",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
