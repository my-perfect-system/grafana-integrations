{
  "folder": "alerts/my-perfect-system/clusters/tortuga",
  "orgId": 1,
  "title": "host_metrics",
  "interval": 60,
  "rules": [
    {
      "uid": "tortuga_host_metrics_down",
      "title": "tortuga_host_metrics_down",
      "condition": "C",
      "for": "5m",
      "noDataState": "NoData",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "category": "host",
        "view": "host"
      },
      "annotations": {
        "summary": "Host {{ $labels.instance }} is down",
        "description": "node-exporter on {{ $labels.instance }} has been unreachable for 5m."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "up{job=\"integrations/unix\"}",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    1
                  ],
                  "type": "lt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    },
    {
      "uid": "tortuga_host_metrics_disk_full",
      "title": "tortuga_host_metrics_disk_full",
      "condition": "C",
      "for": "30m",
      "noDataState": "NoData",
      "execErrState": "Error",
      "labels": {
        "severity": "warning",
        "category": "host",
        "view": "host"
      },
      "annotations": {
        "summary": "Filesystem {{ $labels.mountpoint }} on {{ $labels.instance }} will be full within 24h",
        "description": "predict_linear over the last hour forecasts {{ $labels.mountpoint }} on {{ $labels.instance }} to run out of space within 24 hours."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
