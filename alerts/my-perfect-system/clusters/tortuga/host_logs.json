{
  "folder": "alerts/my-perfect-system/clusters/tortuga",
  "orgId": 1,
  "title": "host_logs",
  "interval": 60,
  "rules": [
    {
      "uid": "tortuga_host_logs_root_login",
      "title": "tortuga_host_logs_root_login",
      "condition": "C",
      "for": "0m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "warning",
        "category": "logs",
        "view": "host"
      },
      "annotations": {
        "summary": "Root login on {{ $labels.mps_alloy_hostname }}",
        "description": "A direct root SSH login (Accepted ... for root) occurred on {{ $labels.mps_alloy_hostname }} in the last 10 minutes."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_LOKI}",
          "model": {
            "editorMode": "code",
            "expr": "sum by (mps_alloy_hostname) (count_over_time({job=\"syslog-auth.log\"} |= \"sshd\" |~ \"Accepted .+ for root from \" [10m]))",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    },
