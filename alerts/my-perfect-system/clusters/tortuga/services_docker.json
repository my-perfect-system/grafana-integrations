{
  "folder": "alerts/my-perfect-system/clusters/tortuga",
  "orgId": 1,
  "title": "services_docker",
  "interval": 60,
  "rules": [
    {
      "uid": "tortuga_services_docker_down",
      "title": "tortuga_services_docker_down",
      "condition": "C",
      "for": "5m",
      "noDataState": "NoData",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "service": "docker",
        "view": "service"
      },
      "annotations": {
        "summary": "Docker/cAdvisor scrape target is down on {{ $labels.mps_alloy_hostname }}",
        "description": "The cAdvisor scrape target on {{ $labels.mps_alloy_hostname }} ({{ $labels.instance }}) has been unreachable for 5m."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "up{job=\"integrations/cadvisor\"}",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    1
                  ],
                  "type": "lt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    },
    {
      "uid": "tortuga_services_docker_oom",
      "title": "tortuga_services_docker_oom",
      "condition": "C",
      "for": "0m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "critical",
        "service": "docker",
        "view": "service"
      },
      "annotations": {
        "summary": "Container {{ $labels.name }} was OOM-killed on {{ $labels.mps_alloy_hostname }}",
        "description": "Container {{ $labels.name }} ({{ $labels.image }}) on {{ $labels.mps_alloy_hostname }} experienced an OOM kill in the last 15 minutes."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "increase(container_oom_events_total{image!=\"\"}[15m])",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    },
    {
      "uid": "tortuga_services_docker_restarted",
      "title": "tortuga_services_docker_restarted",
      "condition": "C",
      "for": "0m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "severity": "warning",
        "service": "docker",
        "view": "service"
      },
      "annotations": {
        "summary": "Container {{ $labels.name }} is restarting on {{ $labels.mps_alloy_hostname }}",
        "description": "Container {{ $labels.name }} ({{ $labels.image }}) on {{ $labels.mps_alloy_hostname }} restarted more than once in the last 10 minutes \u2014 possible crash loop."
      },
      "isPaused": false,
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "${DS_PROMETHEUS}",
          "model": {
            "editorMode": "code",
            "expr": "changes(container_start_time_seconds{image!=\"\"}[10m])",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    1
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "classic_conditions"
          }
        }
      ]
    }
  ]
}